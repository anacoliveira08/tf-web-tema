generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PetShop {
  idSite               Int       @id @default(autoincrement())
  instagram            String
  whatsapp             String
  nome                  String
  endereco             String
  logoUrl              String
  horarioFuncionamento String
  tituloHome           String
  textoQuemSomos       String
  imagemQuemSomosUrl   String
  email                String
  telefone             String

}

model Servico {
  idServico Int     @id @default(autoincrement())
  nome      String
  descricao String
  imagemUrl String
  destaque  Boolean

}

model Banner {
  idBanner Int     @id @default(autoincrement())
  fotoUrl  String
  destaque Boolean

}

model UserAdmin {
  idUserAdmin Int    @id @default(autoincrement())
  nome        String
  email       String @unique
  senhaHash   String
  fotoUrl     String
}

